{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asdads",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b8e6fe19-4821-444a-befa-d75d7171442b","database_name": "ddasdsad" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "acdcf987cd0c4badb3cf13a811b1460d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
